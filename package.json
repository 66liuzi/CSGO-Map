{
  "name": "cs2-dust2-lineups",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "CS2 炽热沙城（Dust II）道具点位查询库 - 纯静态 PWA",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/stamp-sw.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "add-lineup": "node scripts/add-lineup.mjs",
    "remove-samples": "node scripts/remove-samples.mjs",
    "check": "node scripts/gen-image-sizes.mjs && node scripts/validate-lineups.mjs && vitest run",
    "confirm": "node scripts/confirm-review.mjs",
    "lineup": "node scripts/add-lineup.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
